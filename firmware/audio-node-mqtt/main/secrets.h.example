// Copy this file to secrets.h and fill in your own credentials.
// secrets.h is in .gitignore --- never commit real ones.
#pragma once

// Wi-Fi (2.4 GHz only --- the ESP32-S3 has no 5 GHz radio)
#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"

// MQTT username / password. Leave both empty ("") for an anonymous broker.
// If the broker requires auth (it should, on the public internet), put them here
// rather than editing main.c --- config.h holds everything else.
#define MQTT_USER "your-mqtt-user"
#define MQTT_PASS "your-mqtt-password"
